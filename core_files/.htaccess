# ----------------------------------------------------------------------
# SONRISE Security Layer: Directory Protection & Access Isolation
# ----------------------------------------------------------------------

# 1. Disable Directory Browsing completely
# This prevents users from viewing file lists when modifying the URL path.
Options -Indexes

# 2. Block direct web browser access to all sensitive core files
# This denies HTTP requests to database links, mail credentials, or system configs.
<FilesMatch "\.(php|ini|log|json|txt|md)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# 3. Prevent Script Execution within the Core Directory
# In case of an unauthorized file upload exploit, the server won't execute scripts here.
<FilesMatch "\.(php|php5|phtml|sh|py|pl)$">
    RemoveHandler .php .php5 .phtml .sh .py .pl
    ForceType text/plain
</FilesMatch>